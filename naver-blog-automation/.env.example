# 네이버 검색광고 API (키워드 리서치용)
NAVER_API_KEY=your-naver-api-key
NAVER_SECRET_KEY=your-naver-secret-key
NAVER_CUSTOMER_ID=your-customer-id

# 네이버 검색 API (제품 정보 수집용, 선택사항) - https://developers.naver.com 에서 발급
# 앱 등록 → 검색 API 선택 → Client ID/Secret 복사
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# Anthropic Claude API (블로그 글 생성용) - https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=your-anthropic-api-key
